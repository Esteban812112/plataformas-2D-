# Copy this file to backend/.env and replace every placeholder.
# Real values must come from the environment or from the untracked .env file.
# Do not commit .env.

PORT=8082

# The API listens on 8082 so it does not collide with Expo/Metro (8081)
# or the Unity static server (8080).

# JDBC URL for the local PostgreSQL instance.
DATABASE_URL=jdbc:postgresql://localhost:5432/rushbound
DATABASE_USER=rushbound
DATABASE_PASSWORD=change-me
DB_POOL_SIZE=10

# Replace this with a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ISSUER=rushbound
JWT_AUDIENCE=rushbound-api
JWT_EXPIRATION_SECONDS=86400

# BCrypt cost. 12 is a reasonable local default. Tests use a lower cost.
BCRYPT_COST=12

# Browser origins allowed to call the API (Expo web). Comma-separated.
# Native apps (Android/iOS) do not use CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
